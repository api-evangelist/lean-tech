          "item": [
            {
              "name": "Lean Generate Access Token",
              "id": "e1fa2e48-cec1-4d3e-8bca-433d81e3ec04",
              "protocolProfileBehavior": {
                "disableBodyPruning": true
              },
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/x-www-form-urlencoded"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "urlencoded",
                  "urlencoded": [
                    {
                      "description": "(Required) Application ID from the Lean Application Dashboard.",
                      "key": "client_id",
                      "value": "<string>"
                    },
                    {
                      "description": "(Required) Client secret from the Lean Application Dashboard.",
                      "key": "client_secret",
                      "value": "<string>"
                    },
                    {
                      "description": "(Required) ",
                      "key": "grant_type",
                      "value": "client_credentials"
                    },
                    {
                      "description": "(Required) api for backend access, or customer.<customer_id> for SDK access.",
                      "key": "scope",
                      "value": "<string>"
                    }
                  ]
                },
                "url": {
                  "raw": "{{baseUrl}}/oauth2/token",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "oauth2",
                    "token"
                  ]
                },
                "description": "Exchange client_id and client_secret for a JWT access token. Use scope=api for backend API calls or scope=customer.<customer_id> for the LinkSDK.\n"
